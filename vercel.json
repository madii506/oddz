{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/board.js": {
      "maxDuration": 20
    },
    "api/call.js": {
      "maxDuration": 20
    },
    "api/settle.js": {
      "maxDuration": 20
    },
    "api/markets.js": {
      "maxDuration": 20
    },
    "api/news.js": {
      "maxDuration": 20
    },
    "api/rpc.js": {
      "maxDuration": 15
    },
    "api/parlay.js": {
      "maxDuration": 20
    },
    "api/hist.js": {
      "maxDuration": 15
    },
    "api/coins.js": {
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/props.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    }
  ]
}